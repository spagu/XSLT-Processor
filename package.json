{
  "name": "@tradik/xslt-processor",
  "version": "1.2.1",
  "description": "JavaScript implementation of XSLTProcessor for browser environments and CLI",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "dist/xslt-processor.cjs",
  "module": "dist/xslt-processor.js",
  "browser": "dist/xslt-processor.js",
  "types": "dist/xslt-processor.d.ts",
  "bin": {
    "xslt": "bin/xslt.js"
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/xslt-processor.d.ts",
        "default": "./dist/xslt-processor.js"
      },
      "import": {
        "types": "./dist/xslt-processor.d.ts",
        "default": "./dist/xslt-processor.js"
      },
      "require": {
        "types": "./dist/xslt-processor.d.cts",
        "default": "./dist/xslt-processor.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "bin",
    "!src/**/*.test.js",
    "!bin/**/*.test.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=96 --test-coverage-exclude=\"**/*.test.js\" \"src/**/*.test.js\"",
    "test:xslt3": "npm test --workspace @tradik/xslt3",
    "test:watch": "node --test --watch src/**/*.test.js",
    "test:conformance": "node scripts/conformance.mjs",
    "test:dom": "node scripts/test-dom.mjs",
    "test:conformance:unit": "node --test \"scripts/conformance/*.test.mjs\"",
    "conformance:fetch": "node scripts/fetch-conformance.mjs",
    "lint": "eslint src/ bin/ scripts/ tests/browser/ site/ packages/",
    "format": "prettier --write \"src/**/*.js\" \"bin/**/*.js\" \"scripts/**/*.{js,mjs}\" \"tests/browser/**/*.mjs\" \"site/scripts/*.mjs\" \"site/templates/**/js/*.js\" \"packages/*/src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"bin/**/*.js\" \"scripts/**/*.{js,mjs}\" \"tests/browser/**/*.mjs\" \"site/scripts/*.mjs\" \"site/templates/**/js/*.js\" \"packages/*/src/**/*.js\"",
    "prepublishOnly": "npm run build && npm run test",
    "docs:check": "node scripts/check-links.mjs",
    "bench": "node scripts/benchmark/run.mjs",
    "test:browser": "playwright test -c tests/browser/playwright.config.mjs",
    "test:binaries": "node --test \"scripts/binaries/*.test.mjs\" \"scripts/lib/*.test.mjs\"",
    "test:site": "node --test --experimental-test-coverage --test-coverage-include=\"site/**\" --test-coverage-lines=96 \"site/scripts/*.test.mjs\"",
    "site:content": "node site/scripts/build-content.mjs"
  },
  "keywords": [
    "xslt",
    "xsltprocessor",
    "xml",
    "xpath",
    "transform",
    "browser",
    "w3c",
    "javascript"
  ],
  "author": "tradik",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spagu/XSLT-Processor.git"
  },
  "bugs": {
    "url": "https://github.com/spagu/XSLT-Processor/issues"
  },
  "homepage": "https://xslt-processor.tradik.com/",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@xmldom/xmldom": "^0.9.12",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.9"
  },
  "peerDependencies": {
    "@xmldom/xmldom": ">=0.9.0",
    "jsdom": ">=25.0.0"
  },
  "peerDependenciesMeta": {
    "@xmldom/xmldom": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    }
  }
}
