{
  "name": "xslt-migrate-check",
  "version": "0.3.0",
  "description": "Scans a project for XSLT that stops working when Chrome removes native XSLT (Chrome 158, 17 November 2026), writes the migration patch, and tests the stylesheets on @tradik/xslt-processor against the browser",
  "type": "module",
  "bin": {
    "xslt-migrate-check": "./bin/xslt-migrate-check.js",
    "xslt-migrate-test": "./bin/xslt-migrate-test.js"
  },
  "exports": {
    ".": "./src/cli.js",
    "./analyze": "./src/analyze.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "!bin/**/*.test.js",
    "!src/**/*.test.js",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=96 --test-coverage-include=\"src/**\" --test-coverage-include=\"bin/**\" --test-coverage-include=\"test/**\" --test-coverage-exclude=\"**/*.test.js\" \"src/**/*.test.js\" \"bin/**/*.test.js\""
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "@tradik/xslt-processor": "^1.3.2",
    "@tradik/xslt3": "^1.0.0",
    "jsdom": ">=25.0.0"
  },
  "peerDependenciesMeta": {
    "@tradik/xslt-processor": {
      "optional": true
    },
    "@tradik/xslt3": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    }
  },
  "license": "BSD-3-Clause",
  "author": "tradik",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spagu/XSLT-Processor.git",
    "directory": "packages/migrate-check"
  },
  "homepage": "https://xslt-processor.tradik.com/",
  "bugs": {
    "url": "https://github.com/spagu/XSLT-Processor/issues"
  },
  "keywords": [
    "xslt",
    "xsltprocessor",
    "chrome",
    "deprecation",
    "migration",
    "xml-stylesheet",
    "audit",
    "cli",
    "compatibility",
    "codemod"
  ],
  "publishConfig": {
    "access": "public"
  }
}
